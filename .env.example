# Rashcuts local / production server settings
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rashcuts
DB_USER=root
DB_PASSWORD=

# Admin session
SESSION_DAYS=7
COOKIE_NAME=rashcuts_admin_session

# Change-notification email (one bundled email sent to both recipients at logout)
MAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
NOTIFY_DEV_EMAIL=
NOTIFY_CLIENT_EMAIL=

# Optional privacy hash secret for anonymous booking-attempt tracking
BOOKING_IP_HASH_SECRET=change-this-to-a-long-random-string
